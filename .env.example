# ============================================================
# Smart Interior Decor Recommendation Platform - Environment
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- App ----
APP_ENV=development                 # development | production | test
APP_NAME=Smart Decor
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# ---- Security ----
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key for encryption-at-rest abstraction (MVP KMS). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- Database ----
# Production (docker-compose): postgresql+psycopg://decor:decor@postgres:5432/decor
# Local dev fallback: sqlite:///./decor.sqlite3
DATABASE_URL=postgresql+psycopg://decor:decor@postgres:5432/decor
POSTGRES_USER=decor
POSTGRES_PASSWORD=decor
POSTGRES_DB=decor

# ---- Redis ----
# Leave empty to use in-process fakeredis (dev/test only).
REDIS_URL=redis://redis:6379/0
RECOMMEND_CACHE_TTL=3600

# ---- AI Providers (provider-agnostic) ----
# AI_PROVIDER: gemini | openai | mock
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_BACKEND: clip (sentence-transformers CLIP ViT-B/32) | hash (offline deterministic fallback)
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=512

# ---- Storage (S3-compatible: Arvan / Liara / AWS) ----
# STORAGE_BACKEND: s3 | local
STORAGE_BACKEND=local
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=decor-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ir-thr-at1
S3_PUBLIC_BASE_URL=
LOCAL_STORAGE_DIR=./local_storage

# ---- Payment (Zarinpal / Zibal abstraction, sandbox first) ----
PAYMENT_PROVIDER=zarinpal_sandbox   # zarinpal | zarinpal_sandbox | zibal | mock
ZARINPAL_MERCHANT_ID=zarinpal-sandbox-merchant
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback

# ---- Email (share-with-client) ----
EMAIL_PROVIDER=mock                 # mock | resend
RESEND_API_KEY=
EMAIL_FROM=noreply@smartdecor.local

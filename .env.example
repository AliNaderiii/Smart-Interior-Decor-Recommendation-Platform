# ============================================================
# Smart Interior Decor Recommendation Platform — environment template
#
#   cp .env.example .env      # then fill the REQUIRED values below
#
# NEVER commit `.env`. It is gitignored. This file contains placeholders only
# and is verified by `python scripts/audit_secrets.py` on every baseline run.
#
# Legend
#   [REQUIRED-PROD]  must be set to a real value before production traffic
#   [REQUIRED]       must be set in every environment (a default exists but is
#                    unsafe or environment-specific)
#   [OPTIONAL]       safe to leave at the value shown
#   [UNUSED@f97bfad] present for forward-compatibility / tooling but NOT read
#                    by backend `app/core/config.py` or the frontend at this
#                    commit — see docs/RELEASE_BASELINE.md §6
#
# Defaults in this file describe the OFFLINE DEVELOPMENT profile:
#   AI_PROVIDER=mock · EMBEDDING_BACKEND=hash · STORAGE_BACKEND=local
#   PAYMENT_PROVIDER=zarinpal_sandbox · EMAIL_PROVIDER=mock
# That profile needs no third-party credentials and no external network egress.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
# APP_ENV drives fail-fast production validation in app/core/config.py
# (validate_runtime): with APP_ENV=production the process REFUSES TO BOOT if
# SECRET_KEY is default/short, REDIS_URL is empty, or COOKIE_SECURE is false.
# dev: development | CI+tests: test | staging & prod: production
APP_ENV=development                 # [REQUIRED] development | production | test
APP_NAME=Smart Decor                # [OPTIONAL] shown in OpenAPI title
API_V1_PREFIX=/api/v1               # [OPTIONAL] changing this breaks the frontend (BASE_URL is hardcoded to /api/v1)
# Primary browser origin allowed by CORS. Development/test additionally allow
# the two local Vite origins; production allows exactly this one origin.
# staging/prod: set to the exact https origin, e.g. https://decor.example.com
FRONTEND_ORIGIN=http://localhost:5173   # [REQUIRED-PROD]

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# JWT signing key. Generate: openssl rand -hex 32
# MUST be >= 32 chars and MUST NOT be the default when APP_ENV=production.
# Rotating it invalidates every session by design.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32   # [REQUIRED-PROD]
JWT_ALGORITHM=HS256                 # [OPTIONAL] symmetric HS256; changing requires code review
ACCESS_TOKEN_EXPIRE_MINUTES=15      # [OPTIONAL]
REFRESH_TOKEN_EXPIRE_DAYS=7         # [OPTIONAL]
# Fernet key for the encryption-at-rest abstraction (MVP KMS stand-in).
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty is tolerated in dev; set it before storing any encrypted field in prod.
FERNET_KEY=                         # [REQUIRED-PROD]

# ------------------------------------------------------------
# Demo / seed accounts
# ------------------------------------------------------------
# Development/test only. Production validation rejects true, and the
# production compose profile never sets it. Leave false for production.
SEED_DEMO_ACCOUNTS=false            # [OPTIONAL] true only in development/test
DEMO_ACCOUNT_PASSWORD=              # [OPTIONAL] test-only override

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Production / docker-compose : postgresql+psycopg://decor:decor@postgres:5432/decor
# Local dev fallback          : sqlite:///./decor.sqlite3
#
# Alembic is the canonical schema path for both PostgreSQL and SQLite in the
# current tree. Revision 0003 uses Alembic batch mode for its unique
# constraint, so a fresh SQLite database can be upgraded as well as PostgreSQL.
# PostgreSQL 16 + pgvector remains the production validation target.
# See docs/REPRODUCIBILITY.md §4 and integration-request.md IR-002.
DATABASE_URL=postgresql+psycopg://decor:decor@postgres:5432/decor   # [REQUIRED]
# The POSTGRES_* trio is consumed by docker-compose.yml to provision the
# `postgres` service — it is NOT read by the FastAPI Settings object.
POSTGRES_USER=decor                 # [REQUIRED-PROD] docker-compose only
POSTGRES_PASSWORD=decor             # [REQUIRED-PROD] docker-compose only — change before prod
POSTGRES_DB=decor                   # [OPTIONAL] docker-compose only

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# Empty  -> in-process fakeredis. Dev/test ONLY: it is per-worker, so the JWT
#           blacklist, brute-force lockout and rate limits are NOT shared and
#           are trivially bypassed by hitting another worker.
# APP_ENV=production with an empty REDIS_URL refuses to boot.
REDIS_URL=redis://redis:6379/0      # [REQUIRED-PROD]
RECOMMEND_CACHE_TTL=3600            # [OPTIONAL] seconds
# AI cost control: max /recommend calls per user per minute (0 disables —
# used only for load tests, never in production).
RECOMMEND_RATE_LIMIT_PER_MINUTE=20  # [OPTIONAL]
# pgvector HNSW search breadth for the post-filtered ANN query. Measured on a
# 20.7k-row catalog: 40 -> 14/100 candidates, 200 -> 58/100, 400 -> 100/100.
HNSW_EF_SEARCH=400                  # [OPTIONAL] Postgres only

# ------------------------------------------------------------
# AI providers (provider-agnostic)
# ------------------------------------------------------------
# AI_PROVIDER=mock is a deterministic filename/URL heuristic. It is the CI and
# offline baseline and is NOT a real-model result — never present mock
# extraction numbers as production AI accuracy.
AI_PROVIDER=mock                    # [REQUIRED-PROD] gemini | openai | mock
GEMINI_API_KEY=                     # [REQUIRED-PROD] when AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash       # [OPTIONAL]
OPENAI_API_KEY=                     # [REQUIRED-PROD] when AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini            # [OPTIONAL]
# EMBEDDING_BACKEND
#   hash -> deterministic 512-dim offline fallback (hermetic tests, no semantics)
#   clip -> real CLIP ViT-B/32; requires uncommenting torch +
#           sentence-transformers in backend/requirements.txt and ~600 MB of
#           HuggingFace egress on first boot.
EMBEDDING_BACKEND=hash              # [REQUIRED-PROD] clip | hash
EMBEDDING_DIM=512                   # [OPTIONAL] must match the products.style_embedding column

# ------------------------------------------------------------
# Storage (S3-compatible: Arvan / Liara / AWS)
# ------------------------------------------------------------
STORAGE_BACKEND=local               # [REQUIRED-PROD] s3 | local
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir   # [REQUIRED-PROD] when STORAGE_BACKEND=s3
S3_BUCKET=decor-assets              # [REQUIRED-PROD] when STORAGE_BACKEND=s3
S3_ACCESS_KEY=                      # [REQUIRED-PROD] when STORAGE_BACKEND=s3
S3_SECRET_KEY=                      # [REQUIRED-PROD] when STORAGE_BACKEND=s3
S3_REGION=ir-thr-at1                # [REQUIRED-PROD] when STORAGE_BACKEND=s3
S3_PUBLIC_BASE_URL=                 # [OPTIONAL] CDN/public base for object URLs
LOCAL_STORAGE_DIR=./local_storage   # [OPTIONAL] used when STORAGE_BACKEND=local

# ------------------------------------------------------------
# Payment (Zarinpal / Zibal abstraction — sandbox first)
# ------------------------------------------------------------
# No card data is ever stored; only the gateway authority + reference id.
PAYMENT_PROVIDER=zarinpal_sandbox   # [REQUIRED-PROD] zarinpal | zarinpal_sandbox | zibal | mock
ZARINPAL_MERCHANT_ID=zarinpal-sandbox-merchant   # [REQUIRED-PROD] real merchant id
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback   # [REQUIRED-PROD] must be https in prod

# ------------------------------------------------------------
# Email (share-with-client)
# ------------------------------------------------------------
# EMAIL_PROVIDER=mock logs the message and returns success WITHOUT sending.
EMAIL_PROVIDER=mock                 # [REQUIRED-PROD] mock | resend
RESEND_API_KEY=                     # [REQUIRED-PROD] when EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@smartdecor.local # [REQUIRED-PROD] must be a verified sending domain

# ------------------------------------------------------------
# Observability (Stage 07)
# ------------------------------------------------------------
LOG_LEVEL=INFO                      # [OPTIONAL] DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                     # [OPTIONAL] production compose sets json
METRICS_ENABLED=true                # [OPTIONAL] expose Prometheus /metrics

# ------------------------------------------------------------
# V2 security hardening (Phase 1)
# ------------------------------------------------------------
# httpOnly cookie auth (OWASP A02). Set false only for local Bearer/CLI flows.
USE_COOKIE_AUTH=true                # [OPTIONAL]
COOKIE_SECURE=true                  # [REQUIRED-PROD] production boot fails if false
COOKIE_SAMESITE=strict              # [OPTIONAL] strict | lax | none
# Auth abuse controls (OWASP A07). Targeted guessing is additionally stopped by
# app/core/brute_force.py: 5 failures per ip+email -> 15 minute lockout.
LOGIN_RATE_LIMIT_PER_MINUTE=30      # [OPTIONAL] coarse per-IP flood guard
REGISTER_RATE_LIMIT_PER_MINUTE=3    # [OPTIONAL]
RECOMMEND_IP_RATE_LIMIT_PER_MINUTE=100   # [OPTIONAL]

# ------------------------------------------------------------
# Reserved / not yet wired  [UNUSED@f97bfad]
# ------------------------------------------------------------
# Verified by grep across backend/app, backend/ai, backend/scripts,
# frontend/src, frontend/vite.config.ts and frontend/Dockerfile: none of the
# variables below is read by any source file at this commit. They are kept so
# the dataset/service-key templates in datasets/service_keys_template.env stay
# aligned, but setting them today has NO EFFECT. Do not rely on them.
#   - STORAGE_PROVIDER      superseded by STORAGE_BACKEND
#   - CDN_URL               superseded by S3_PUBLIC_BASE_URL
#   - CORS_ORIGINS          superseded by FRONTEND_ORIGIN (single origin only)
#   - VITE_API_URL          frontend BASE_URL is hardcoded to "/api/v1"
#   - ZARINPAL_SANDBOX      superseded by PAYMENT_PROVIDER=zarinpal_sandbox
#   - ZARINPAL_CALLBACK_URL superseded by PAYMENT_CALLBACK_URL
#   - RESEND_FROM_EMAIL     superseded by EMAIL_FROM
#   - RESEND_FROM_NAME      no sender-name support in app/services/emailer.py
# Tracked as IR-004 in integration-request.md.
STORAGE_PROVIDER=mock               # [UNUSED@f97bfad] mock | arvan | liara | aws
CDN_URL=                            # [UNUSED@f97bfad]
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # [UNUSED@f97bfad]
VITE_API_URL=/api/v1                # [UNUSED@f97bfad]
ZARINPAL_SANDBOX=true               # [UNUSED@f97bfad]
ZARINPAL_CALLBACK_URL=http://localhost:8080/upgrade        # [UNUSED@f97bfad]
RESEND_FROM_EMAIL=noreply@smartdecor.local                 # [UNUSED@f97bfad]
RESEND_FROM_NAME=Smart Decor        # [UNUSED@f97bfad]

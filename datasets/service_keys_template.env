# Service Keys Template - 6th Dataset
# Inspired by: Vercel env template + Houzz infra
# Copy this to .env and fill with real keys
# For demo, all can be mock

# =============================================================================
# 1. DATABASE & CACHE - Already working with Docker
# =============================================================================
POSTGRES_USER=decor
POSTGRES_PASSWORD=decor
POSTGRES_DB=decor
DATABASE_URL=postgresql+psycopg://decor:decor@postgres:5432/decor
REDIS_URL=redis://redis:6379/0

# For tests (decor_test) - auto-created by docker-compose.test.yml
# DATABASE_URL_TEST=postgresql+psycopg://decor:decor@postgres:5432/decor_test

# =============================================================================
# 2. AI - Provider-Agnostic (Most Important for Real Data)
# Inspired by: OpenAI + Google AI Studio
# =============================================================================

# Choose: mock | gemini | openai | clip_local
AI_PROVIDER=mock
# For production, set to gemini:
# AI_PROVIDER=gemini

# Gemini 2.0 Flash - for feature extraction (color, style, material from image)
# Get from: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day - enough for 500 products
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI GPT-4o-mini - alternative for feature extraction
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Embedding Backend - how to generate style_embedding vectors
# mock = deterministic hash (offline, CI, demo) - current
# clip_local = real CLIP ViT-B/32 512-dim (needs huggingface download)
# openai = text-embedding-3-small
EMBEDDING_BACKEND=hash
# For production:
# EMBEDDING_BACKEND=clip_local
# CLIP_MODEL=openai/clip-vit-base-patch32

# For real embeddings file generation (one-time on networked machine):
# python backend/scripts/seed_products.py --real-embeddings
# This creates backend/seed_data/embeddings_real.json

# =============================================================================
# 3. S3 STORAGE - ArvanCloud / Liara / AWS
# Inspired by: ArvanCloud S3 + Wayfair image CDN
# =============================================================================

# Choose: mock | arvan | liara | aws
STORAGE_PROVIDER=mock
# For production:
# STORAGE_PROVIDER=arvan

# ArvanCloud S3 (recommended for Iran - fast, cheap, not filtered)
# Get from: https://panel.arvancloud.ir -> Object Storage -> Create Bucket
S3_ENDPOINT=https://s3.ir-thr1.arvanstorage.ir
S3_BUCKET=smart-decor-products
S3_ACCESS_KEY=your_arvan_access_key
S3_SECRET_KEY=your_arvan_secret_key
S3_REGION=ir-thr1

# Liara S3 (alternative)
# S3_ENDPOINT=https://storage.c2.liara.space
# S3_BUCKET=smart-decor
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# AWS S3 (for international)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=smart-decor-prod
# S3_REGION=us-east-1

# For mock (current): files saved to local /tmp and URL is placeholder

# =============================================================================
# 4. PAYMENT - Zarinpal
# Inspired by: Zarinpal Sandbox + Stripe
# =============================================================================

# Choose: mock | zarinpal
PAYMENT_PROVIDER=mock
# For production:
# PAYMENT_PROVIDER=zarinpal

# Zarinpal Sandbox (current) - no real money, no card storage
# Docs: https://docs.zarinpal.com/
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://localhost:8080/payment/verify

# For Production:
# ZARINPAL_MERCHANT_ID=your_real_merchant_id_from_zarinpal_panel
# ZARINPAL_SANDBOX=false
# ZARINPAL_CALLBACK_URL=https://yourdomain.com/payment/verify

# Important: We NEVER store card data, only redirect token - per client security req

# =============================================================================
# 5. EMAIL - Resend / SMTP (for Designer sharing)
# Inspired by: Resend + Havenly sharing
# =============================================================================

# Choose: mock | resend | smtp
EMAIL_PROVIDER=mock
# For production:
# EMAIL_PROVIDER=resend

# Resend (recommended - simple, good deliverability)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Smart Decor Platform

# SMTP alternative (e.g., Gmail, Arvan Email)
# SMTP_HOST=smtp.c1.liara.email
# SMTP_PORT=587
# SMTP_USER=your_email
# SMTP_PASSWORD=your_password

# For mock (current): mailto: link + copy to clipboard + toast
# No real email sent, but UI works

# =============================================================================
# 6. SECURITY & APP CONFIG
# Inspired by: OWASP A05 + Linear env
# =============================================================================

# Secret key for JWT - MUST be >32 chars in production, crash if weak
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars
# Generate with: openssl rand -hex 32

# App environment: development | production | test
APP_ENV=development
# For production:
# APP_ENV=production

# Cookie auth: true = httpOnly Secure cookies (prod), false = localStorage (dev)
USE_COOKIE_AUTH=false
# For production:
# USE_COOKIE_AUTH=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://localhost

# Rate limiting (per user per minute for /recommend)
RATE_LIMIT_RECOMMEND_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Fernet key for encryption at rest (KMS abstraction)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# =============================================================================
# 7. CDN & FRONTEND
# Inspired by: Arvan CDN + Vercel
# =============================================================================

# Frontend API URL (what browser uses to call backend)
# For local Docker without Caddy:
VITE_API_URL=http://localhost:8080
# For local Vite dev (npm run dev):
# VITE_API_URL=http://localhost:8000
# For production with Caddy:
# VITE_API_URL=https://yourdomain.com
# For GitHub Pages + Liara backend:
# VITE_API_URL=https://your-backend.liara.run

# CDN URL for images (if using Arvan CDN)
CDN_URL=https://your-cdn.arvancloud.ir
# For mock: empty or /

# =============================================================================
# NOTES FOR CLIENT - What to provide for production
# =============================================================================
#
# For MVP demo (current): All can stay mock, everything works offline
#
# For production with real Iranian products:
# 1. GEMINI_API_KEY - Get free from aistudio.google.com (1500 req/day)
# 2. S3 keys from ArvanCloud (create bucket + get keys)
# 3. Zarinpal Merchant ID from zarinpal.com/panel
# 4. Optional: RESEND_API_KEY from resend.com
# 5. SECRET_KEY and FERNET_KEY - generate random
#
# Then:
# python backend/scripts/seed_products.py --real-embeddings
# -> creates backend/seed_data/embeddings_real.json with real CLIP vectors
# -> commit it
# -> docker compose up --build -d
#
# All mock fallbacks work offline, real keys make it production-grade
# No card data stored, GDPR delete works, TLS 1.3 via Caddy

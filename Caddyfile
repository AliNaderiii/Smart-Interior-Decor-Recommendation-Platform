# Caddy reverse proxy — automatic HTTPS with TLS 1.3 enforced.
# For production replace :443 with your domain (e.g. decor.example.com)
# and Caddy will provision Let's Encrypt certificates automatically.

{
	email admin@smartdecor.local
}

:443 {
	tls internal {
		protocols tls1.3 tls1.3
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

:80 {
	redir https://{host}{uri} permanent
}

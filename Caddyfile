# Caddy reverse proxy — automatic HTTPS with TLS 1.3 enforced.
# For production replace :443 with your domain (e.g. decor.example.com)
# and Caddy will provision Let's Encrypt certificates automatically.

{
	email admin@smartdecor.local
}

:443 {
	tls internal {
		protocols tls1.3 tls1.3
	}

	encode zstd gzip

	# V2 (OWASP A05): full header set, mirrored by the FastAPI
	# SecurityHeadersMiddleware so protection survives proxy drift.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# SINGLE SOURCE OF TRUTH (Stage 2, T-2.4 / B-11): this string is
		# GENERATED by `python backend/scripts/print_csp.py --reference` from
		# build_csp() in backend/app/core/security_headers.py, and
		# backend/tests/test_csp_alignment.py fails CI whenever the two drift.
		# Never hand-edit it — change the image-host settings (S3_ENDPOINT,
		# S3_PUBLIC_BASE_URL, IMAGE_CDN_BASE_URL, IMAGE_EXTRA_ORIGINS),
		# re-run the script, and paste its output here (docs/DEPLOYMENT.md
		# §"Product-image hosts & CSP").
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://s3.ir-thr-at1.arvanstorage.ir https://*.s3.ir-thr-at1.arvanstorage.ir; connect-src 'self' https://generativelanguage.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}

	# Prometheus scrapes the bare endpoint; restrict access at the network
	# boundary or collector-facing listener in a deployment that is not
	# private. The application emits no user or token labels.
	handle /metrics {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}

:80 {
	redir https://{host}{uri} permanent
}

# ============================================================================
# STAGING ENVIRONMENT TEMPLATE — Stage 4, T-4.1
# ============================================================================
# This file is a REDACTED TEMPLATE. It is committed. The real file is created
# ON THE HOST ONLY:
#
#     cp .env.staging.example .env
#     chmod 600 .env
#     $EDITOR .env        # fill every [FILL] below
#     python3 scripts/assert_staging_env.py .env --host staging.example.com
#
# NEVER commit the filled .env. `scripts/deploy_staging.sh` refuses to deploy
# if `scripts/assert_staging_env.py` finds a placeholder or weak value, so a
# half-filled file fails fast instead of serving a public host unsafely.
#
# ---------------------------------------------------------------------------
# WHY APP_ENV=development ON A PUBLIC HOST (decision D-4.1 — read this)
# ---------------------------------------------------------------------------
# Settings.validate_runtime() refuses APP_ENV=production when AI_PROVIDER=mock
# or STORAGE_BACKEND=local. Supervisor ruling R3 mandates exactly that profile
# for staging (no API key, no bucket on a public demo box). We did NOT weaken
# that validation. Instead:
#   * docker-compose.staging.yml pins every production-shaped setting
#     explicitly (secure cookies, json logs, shared Redis, resource limits);
#   * scripts/assert_staging_env.py re-asserts those production checks at
#     deploy time and FAILS the deploy if any is missing;
#   * the invariant that matters — demo accounts can never exist under
#     APP_ENV=production — is re-proven on every deploy by
#     scripts/prove_demo_refusal.sh.
# Stage 5 production cutover simply swaps in docker-compose.prod.yml with a
# real AI key and S3 bucket, and every production fail-safe applies unchanged.
# ============================================================================

# ---------------------------------------------------------------------------
# Host identity — the ONE value everything else is keyed to
# ---------------------------------------------------------------------------
# Plain hostname, no scheme, no port, no trailing slash. Must already have an
# A record pointing at this server BEFORE the first deploy (Caddy needs it for
# the ACME HTTP-01 challenge).
STAGING_HOST=staging.example.com          # [FILL]
# ACME registration address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com                # [FILL]

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development                       # see D-4.1 above — do not change
APP_NAME=Smart Decor
API_V1_PREFIX=/api/v1
# Must be exactly https://${STAGING_HOST} — the deploy gate cross-checks it.
FRONTEND_ORIGIN=https://staging.example.com   # [FILL]

# ---------------------------------------------------------------------------
# Security — generate every one of these ON THE HOST, never reuse a dev value
# ---------------------------------------------------------------------------
#   openssl rand -hex 32
SECRET_KEY=                               # [FILL] >=32 chars, non-default
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=                               # [FILL] urlsafe-base64 32-byte key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public HTTPS host: cookies are secure + strict, exactly as in production.
USE_COOKIE_AUTH=true
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Abuse controls (unchanged from the production profile).
LOGIN_RATE_LIMIT_PER_MINUTE=30
REGISTER_RATE_LIMIT_PER_MINUTE=3
RECOMMEND_IP_RATE_LIMIT_PER_MINUTE=100
SHARE_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Demo accounts — STAGING ONLY (client decision C-7)
# ---------------------------------------------------------------------------
# The three documented logins (admin@ / designer@ / demo@ smartdecor.dev) are
# created with the RANDOMIZED password below instead of their well-known dev
# defaults, because this host is public. Deliver the password to the client
# out-of-band (never in the repo, never in a ticket).
#   openssl rand -base64 18
SEED_DEMO_ACCOUNTS=true
DEMO_ACCOUNT_PASSWORD=                    # [FILL] >=12 chars, randomized

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector, container-internal only — never published)
# ---------------------------------------------------------------------------
POSTGRES_USER=decor
#   openssl rand -base64 24
POSTGRES_PASSWORD=                        # [FILL] >=16 chars, not "decor"
POSTGRES_DB=decor
# LEAVE EMPTY. docker-compose builds the real DATABASE_URL from the trio above,
# so duplicating the password here would only be a second place to leak it.
# Host-side tools (backup, restore, the DR drill) read the password from this
# same file instead:
#   export PGPASSWORD="$(grep -E '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)"
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis (shared state: JWT blacklist, lockouts, rate limits, recommend cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
RECOMMEND_CACHE_TTL=3600
RECOMMEND_RATE_LIMIT_PER_MINUTE=20
HNSW_EF_SEARCH=400

# ---------------------------------------------------------------------------
# AI — WAIVED to mock by supervisor ruling R3
# ---------------------------------------------------------------------------
# mock is a deterministic filename/URL heuristic. The demo is complete and
# repeatable, but the extraction numbers are NOT real-model accuracy and must
# never be presented as such. Stage 5 sets AI_PROVIDER=gemini + a real key.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=512
# Client decision C-6: "current" (ADR-005 baseline) vs "client-ad".
RECOMMENDER_WEIGHT_PROFILE=current

# ---------------------------------------------------------------------------
# Storage — WAIVED to local by supervisor ruling R3
# ---------------------------------------------------------------------------
# Uploads land on the `media` docker volume (mounted at /app/local_storage) and
# are included in the nightly backup tarball. Stage 5 sets STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_PIXELS=40000000
MAX_UPLOAD_EDGE_PX=12000
# Leave the image-host knobs EMPTY on staging: setting them changes build_csp()
# output and the Caddyfile copy would drift (test_csp_alignment.py).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=
IMAGE_CDN_BASE_URL=
IMAGE_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# Payment — Zarinpal SANDBOX (no money moves, no merchant registration)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=zarinpal_sandbox
ZARINPAL_MERCHANT_ID=zarinpal-sandbox-merchant
# Must be on the staging host or the gateway cannot return the user.
PAYMENT_CALLBACK_URL=https://staging.example.com/payment/callback   # [FILL]

# ---------------------------------------------------------------------------
# Email — mock (logs the message, sends nothing)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@staging.example.com    # [FILL]
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
# Client decision C-02 (audit retention). Default 180 days.
AUDIT_LOG_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# White-label switch (T-4.4) — build-time, zero code edits
# ---------------------------------------------------------------------------
# Change these and re-run ./scripts/deploy_staging.sh to rebrand the SPA.
VITE_BRAND_NAME=Smart Decor
VITE_BRAND_COLOR=
VITE_BRAND_LOGO_URL=

# ---------------------------------------------------------------------------
# Ops (T-4.3) — used by the uptime probe and nightly backup
# ---------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
# Optional Telegram alerting; deferred by R3. Empty = log to file only.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
